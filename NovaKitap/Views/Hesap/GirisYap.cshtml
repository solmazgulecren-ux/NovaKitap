@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="card p-4 shadow-lg" style="background-color: var(--space-blue); border: 1px solid var(--grey-accent); width: 100%; max-width: 400px; border-radius: 12px;">
        <div class="text-center mb-4">
            <h2 style="color: var(--star-beige);">✦ NOVA'ya Giriş</h2>
            <p class="text-muted">Kendi uzayında kaybolmaya hazır mısın?</p>
        </div>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Hata
            </div>
        }
        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["Mesaj"]
            </div>
        }

        <form asp-action="GirisYap" method="post">
            <div class="mb-3">
                <label class="form-label text-light">E-posta Adresi</label>
                <input type="email" name="email" class="form-control nova-search" required placeholder="ornek@email.com" />
            </div>
            <div class="mb-4">
                <label class="form-label text-light">Şifre</label>
                <input type="password" name="sifre" class="form-control nova-search" required placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-nova w-100 mb-3">Giriş Yap</button>
        </form>

        <div class="text-center mt-2">
            <span style="color: var(--silver);">Hesabın yok mu? </span>
            <a asp-action="KayitOl" style="color: var(--star-beige); text-decoration: none;">Hemen Kayıt Ol</a>
        </div>
    </div>
</div>