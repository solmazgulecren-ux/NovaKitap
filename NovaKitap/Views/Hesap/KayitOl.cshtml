@model NovaKitap.Models.Kullanicilar

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card p-4 shadow-lg" style="background-color: var(--space-blue); border: 1px solid var(--grey-accent); width: 100%; max-width: 450px; border-radius: 12px;">
        <div class="text-center mb-4">
            <h2 style="color: var(--star-beige);">✦ NOVA'ya Katıl</h2>
            <p style="color: var(--silver);">Kendi evrenini inşa etmeye başla.</p>
        </div>

        <!-- Yönlendirme garantili form action -->
        <form action="/Hesap/KayitOl" method="post">
            <div class="mb-3">
                <label class="form-label text-light">Adınız Soyadınız</label>
                <input name="AdSoyad" type="text" class="form-control nova-search" required placeholder="Örn: Ada Lovelace" />
            </div>
            
            <div class="mb-3">
                <label class="form-label text-light">E-posta Adresi</label>
                <input name="Email" type="email" class="form-control nova-search" required placeholder="ornek@email.com" />
            </div>
            
            <div class="mb-3">
                <label class="form-label text-light">Şifre</label>
                <input name="Sifre" type="password" class="form-control nova-search" required placeholder="Güçlü bir şifre belirleyin" />
            </div>

            <div class="mb-4">
                <label class="form-label text-light">Hesap Türü</label>
                <select name="Rol" class="form-select nova-search" required>
                    <option value="Musteri">Standart Müşteri</option>
                    <option value="Admin">Sistem Yöneticisi (Admin)</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-nova w-100 mb-3">Yolculuğa Başla (Kayıt Ol)</button>
        </form>

        <div class="text-center mt-2">
            <span style="color: var(--silver);">Zaten bir yıldız haritan var mı? </span>
            <!-- Yönlendirme garantili href -->
            <a href="/Hesap/GirisYap" style="color: var(--star-beige); text-decoration: none; font-weight: bold;">Giriş Yap</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}