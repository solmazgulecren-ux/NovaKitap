@model NovaKitap.Models.StokYonetimiViewModel
@{
    ViewData["Title"] = "Stok ve Fiyat Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: var(--star-beige);">✦ Stok ve Fiyat Yönetimi</h2>
        <a href="/Admin/Index" class="btn btn-outline-light">Geri Dön</a>
    </div>
    
    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Mesaj"]</div>
    }

    <!-- Sekmeler -->
    <ul class="nav nav-tabs" id="stokTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#kitap" type="button" role="tab">Kitaplar</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#kirtasiye" type="button" role="tab">Kırtasiye</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#oyuncak" type="button" role="tab">Oyuncaklar</button>
        </li>
    </ul>

    <!-- Sekme İçerikleri -->
    <div class="tab-content bg-white p-0 border border-top-0 shadow-sm" id="stokTabContent" style="border-radius: 0 0 12px 12px; overflow: hidden;">
        
        <!-- 1. KİTAPLAR TABLOSU -->
        <div class="tab-pane fade show active" id="kitap" role="tabpanel">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--space-blue); color: var(--star-beige);">
                    <tr><th class="ps-3">ID</th><th>Ürün Adı</th><th>Stok Adedi</th><th>Fiyat (₺)</th><th>İşlem</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Kitaplar)
                    {
                        <tr>
                            <td class="ps-3">@item.KitapId</td>
                            <td>@item.KitapAdi</td>
                            <td><input type="number" form="form-kitap-@item.KitapId" name="Stok" value="@item.StokAdedi" class="form-control form-control-sm" style="width: 90px;" /></td>
                            <td><input type="text" form="form-kitap-@item.KitapId" name="Fiyat" value="@item.Fiyat" class="form-control form-control-sm" style="width: 100px;" /></td>
                            <td>
                                <form id="form-kitap-@item.KitapId" action="/Admin/StokGuncelle" method="post" class="m-0 p-0">
                                    <input type="hidden" name="UrunTuru" value="Kitap" />
                                    <input type="hidden" name="UrunId" value="@item.KitapId" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold">Kaydet</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 2. KIRTASİYE TABLOSU -->
        <div class="tab-pane fade" id="kirtasiye" role="tabpanel">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--space-blue); color: var(--star-beige);">
                    <tr><th class="ps-3">ID</th><th>Ürün Adı</th><th>Stok Adedi</th><th>Fiyat (₺)</th><th>İşlem</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Kirtasiyeler)
                    {
                        <tr>
                            <td class="ps-3">@item.KirtasiyeId</td>
                            <td>@item.UrunAdi</td>
                            <td><input type="number" form="form-kirtasiye-@item.KirtasiyeId" name="Stok" value="@item.StokAdedi" class="form-control form-control-sm" style="width: 90px;" /></td>
                            <td><input type="text" form="form-kirtasiye-@item.KirtasiyeId" name="Fiyat" value="@item.Fiyat" class="form-control form-control-sm" style="width: 100px;" /></td>
                            <td>
                                <form id="form-kirtasiye-@item.KirtasiyeId" action="/Admin/StokGuncelle" method="post" class="m-0 p-0">
                                    <input type="hidden" name="UrunTuru" value="Kirtasiye" />
                                    <input type="hidden" name="UrunId" value="@item.KirtasiyeId" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold">Kaydet</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 3. OYUNCAKLAR TABLOSU -->
        <div class="tab-pane fade" id="oyuncak" role="tabpanel">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--space-blue); color: var(--star-beige);">
                    <tr><th class="ps-3">ID</th><th>Ürün Adı</th><th>Stok Adedi</th><th>Fiyat (₺)</th><th>İşlem</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Oyuncaklar)
                    {
                        <tr>
                            <td class="ps-3">@item.OyuncakId</td>
                            <td>@item.UrunAdi</td>
                            <td><input type="number" form="form-oyuncak-@item.OyuncakId" name="Stok" value="@item.StokAdedi" class="form-control form-control-sm" style="width: 90px;" /></td>
                            <td><input type="text" form="form-oyuncak-@item.OyuncakId" name="Fiyat" value="@item.Fiyat" class="form-control form-control-sm" style="width: 100px;" /></td>
                            <td>
                                <form id="form-oyuncak-@item.OyuncakId" action="/Admin/StokGuncelle" method="post" class="m-0 p-0">
                                    <input type="hidden" name="UrunTuru" value="Oyuncak" />
                                    <input type="hidden" name="UrunId" value="@item.OyuncakId" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold">Kaydet</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>