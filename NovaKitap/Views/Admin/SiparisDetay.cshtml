@model NovaKitap.Models.Siparis
@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Controller'dan gönderdiğimiz ViewBag verilerini karşılıyoruz
    var kullanici = ViewBag.Kullanici as NovaKitap.Models.Kullanicilar;
    var detaylar = ViewBag.Detaylar as List<NovaKitap.Models.SiparisDetayi>;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: var(--star-beige);">✦ Sipariş #@Model.SiparisId Detayları</h2>
        <a href="/Admin/SiparisYonetimi" class="btn btn-outline-light">Siparişlere Dön</a>
    </div>

    <div class="row g-4">
        <!-- Sol Taraf: Müşteri ve Kargo Bilgileri -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100" style="background-color: var(--space-blue); border: 1px solid var(--grey-accent); border-radius: 12px;">
                <h5 style="color: var(--star-beige); border-bottom: 1px solid var(--grey-accent); padding-bottom: 10px;">Müşteri Bilgileri</h5>
                <p class="text-light mt-3 mb-1"><strong>Ad Soyad:</strong> @(kullanici != null ? kullanici.AdSoyad : "Bilinmiyor")</p>
                <p class="text-light mb-1"><strong>Tarih:</strong> @Model.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</p>
                <p class="text-light mb-1"><strong>Durum:</strong> <span class="badge bg-warning text-dark">@Model.SiparisDurumu</span></p>
                
                <h5 style="color: var(--star-beige); border-bottom: 1px solid var(--grey-accent); padding-bottom: 10px; margin-top: 20px;">Kargo ve Ödeme</h5>
                <p class="text-light mt-3 mb-1"><strong>Adres:</strong> @Model.KargoAdresi</p>
                <p class="text-light mb-1"><strong>Ödeme Yöntemi:</strong> @(string.IsNullOrEmpty(Model.OdemeYontemi) ? "Kredi Kartı" : Model.OdemeYontemi)</p>
                <h4 class="text-success mt-3 fw-bold">Toplam: @Model.ToplamTutar ₺</h4>
            </div>
        </div>

        <!-- Sağ Taraf: Satın Alınan Ürünler -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: var(--header-bg); color: #fff;">
                        <tr>
                            <th class="ps-3">Ürün ID</th>
                            <th>Adet</th>
                            <th>Birim Fiyat</th>
                            <th>Ara Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (detaylar != null && detaylar.Count > 0)
                        {
                            foreach (var urun in detaylar)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@urun.KitapId</td>
                                    <td><span class="badge bg-secondary">@urun.Adet x</span></td>
                                    <td>@urun.BirimFiyat ₺</td>
                                    <td class="fw-bold">@(urun.Adet * urun.BirimFiyat) ₺</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Bu siparişe ait ürün detayı bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>