@section Scripts {
<script>
    // ===== AJAX İLE SİPARİŞ DURUMU GÜNCELLEME =====
    async function durumGuncelle(siparisId, yeniDurum, kargoAnimasyonuGoster) {

        // Kargo animasyonunu göster
        if (kargoAnimasyonuGoster) {
            kargoAnimasyonuBaslat();
        }

        try {
            const formData = new FormData();
            formData.append('siparisId', siparisId);
            formData.append('yeniDurum', yeniDurum);

            const response = await fetch('/Admin/SiparisDurumGuncelle', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.basarili) {
                // Kargo animasyonu bitmesini bekle
                if (kargoAnimasyonuGoster) {
                    // Animasyon zaten çalışıyor, bitince tablo güncellenecek
                    setTimeout(() => {
                        tabloSatiriniGuncelle(siparisId, data.yeniDurum);
                        bildirimGoster(data.mesaj, 'success');
                    }, 2200);
                } else {
                    tabloSatiriniGuncelle(siparisId, data.yeniDurum);
                    bildirimGoster(data.mesaj, 'success');
                }
            } else {
                bildirimGoster(data.mesaj, 'danger');
            }
        } catch (error) {
            bildirimGoster('Bir hata oluştu! Lütfen tekrar deneyin.', 'danger');
            kargoAnimasyonunuKapat();
        }
    }

    // ===== TABLO SATIRINI ANLIK GÜNCELLE =====
    function tabloSatiriniGuncelle(siparisId, yeniDurum) {
        // Durum badge'ini güncelle
        const badge = document.getElementById('durum-badge-' + siparisId);
        if (badge) {
            badge.className = 'badge px-3 py-2 ' + durumBadgeSinifi(yeniDurum);
            badge.style.fontSize = '0.8rem';
            badge.style.borderRadius = '8px';
            badge.textContent = yeniDurum;
        }

        // Satırı parlatma efekti
        const satir = document.getElementById('siparis-satir-' + siparisId);
        if (satir) {
            satir.classList.add('durum-guncellendi');
            setTimeout(() => satir.classList.remove('durum-guncellendi'), 600);
        }

        // Butonları güncelle
        const islemHucre = satir?.querySelector('td:last-child .d-flex');
        if (islemHucre) {
            const detayBtn = islemHucre.querySelector('a');
            const detayHTML = detayBtn ? detayBtn.outerHTML : '';

            if (yeniDurum === 'Onaylandı' || yeniDurum === 'Hazırlanıyor') {
                islemHucre.innerHTML = detayHTML +
                    '<button class="btn-onayla" disabled>✅ Onaylandı</button>' +
                    '<button class="btn-kargover" onclick="durumGuncelle(' + siparisId + ', \'Kargoya Verildi\', true)">🚚 Kargoya Ver</button>';
            } else if (yeniDurum === 'Kargoya Verildi' || yeniDurum === 'Teslim Edildi' || yeniDurum === 'Tamamlandı') {
                islemHucre.innerHTML = detayHTML +
                    '<button class="btn-onayla" disabled>✅ Onayla</button>' +
                    '<button class="btn-kargover" disabled>🚚 Kargoda</button>';
            }
        }
    }

    function durumBadgeSinifi(durum) {
        switch (durum) {
            case 'Onay Bekliyor': return 'bg-warning text-dark';
            case 'Onaylandı': return 'bg-success';
            case 'Hazırlanıyor': return 'bg-primary';
            case 'Kargoya Verildi': return 'bg-info text-dark';
            case 'Teslim Edildi': return 'bg-success';
            case 'Tamamlandı': return 'bg-success';
            case 'İptal Edildi': return 'bg-danger';
            default: return 'bg-secondary';
        }
    }

    // ===== BİLDİRİM GÖSTER =====
    function bildirimGoster(mesaj, tip) {
        const bildirim = document.getElementById('ajaxBildirim');
        bildirim.className = 'alert alert-' + tip + ' shadow-sm fw-bold mb-3';
        bildirim.style.borderRadius = '10px';
        bildirim.textContent = (tip === 'success' ? '✅ ' : '❌ ') + mesaj;
        bildirim.style.display = 'block';

        setTimeout(() => {
            bildirim.style.display = 'none';
        }, 4000);
    }

    // ===== KARGO KAMYON ANİMASYONU =====
    function kargoAnimasyonuBaslat() {
        const overlay = document.getElementById('kargoOverlay');
        const kamyon = document.getElementById('kamyonAnimasyon');
        const mesaj = document.getElementById('kargoMesaj');
        const basarili = document.getElementById('kargoBasarili');

        // Reset
        overlay.style.display = 'flex';
        kamyon.style.transition = 'none';
        kamyon.style.left = '-120px';
        mesaj.style.opacity = '0';
        mesaj.textContent = '📦 Kargo Yolda...';
        basarili.style.display = 'none';

        // Mesajı göster
        setTimeout(() => {
            mesaj.style.opacity = '1';
        }, 100);

        // Kamyon animasyonunu başlat
        setTimeout(() => {
            kamyon.style.transition = 'left 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            kamyon.style.left = 'calc(100% + 20px)';
        }, 200);

        // Animasyon bittiğinde başarılı mesajını göster
        setTimeout(() => {
            mesaj.style.opacity = '0';
            setTimeout(() => {
                basarili.style.display = 'block';
                basarili.style.animation = 'basariliGiris 0.5s ease';
            }, 300);
        }, 1800);

        // Overlay'i kapat
        setTimeout(() => {
            kargoAnimasyonunuKapat();
        }, 3000);
    }

    function kargoAnimasyonunuKapat() {
        document.getElementById('kargoOverlay').style.display = 'none';
    }
</script>

<style>
    @@keyframes basariliGiris {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>
}
