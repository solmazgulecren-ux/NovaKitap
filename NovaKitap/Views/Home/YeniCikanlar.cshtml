@{
    ViewData["Title"] = "Yeni Çıkanlar"; // Burayı sayfanın adına göre değiştir
}

<div class="container mt-5">
    <h2 style="color: var(--silver);">
        <span style="color: var(--star-beige);">✦</span> @ViewData["Title"]
    </h2>
    <hr style="border-color: var(--grey-accent);" />
    <div class="p-5 text-center" style="background-color: var(--space-blue); border-radius: 15px; border: 1px dashed var(--silver);">
        <p class="text-muted fs-5">Bu sayfa şu an yapım aşamasındadır. Yıldızlar henüz buraya taşınmadı...</p>
    </div>
</div>