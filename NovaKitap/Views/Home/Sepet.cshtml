@model List<NovaKitap.Models.Kitaplar>

@{
    ViewData["Title"] = "Sepetim";
    decimal toplamFiyat = Model != null ? Model.Sum(k => k.Fiyat) : 0;
}

<div class="container-fluid py-4">
    <h2 class="mb-4" style="color: var(--silver);">
        <span style="color: var(--star-beige);">✦</span> Uzay Kapsülünüz (Sepetiniz)
    </h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var kitap in Model)
                {
                    <div class="card mb-3 p-3 shadow-sm" style="background-color: var(--space-blue); border: 1px solid var(--grey-accent); border-radius: 10px;">
                        <div class="row g-0 align-items-center">
                            <div class="col-md-2 text-center">
                                <img src="@(string.IsNullOrEmpty(kitap.KapakResimUrl) ? "https://via.placeholder.com/100x150/1B2A4A/C0C0C0?text=Kapak+Yok" : kitap.KapakResimUrl)" 
                                     class="img-fluid rounded shadow-sm" 
                                     style="max-height: 110px; object-fit: cover; border: 1px solid var(--grey-accent);" 
                                     alt="@kitap.KitapAdi">
                            </div>
                            <div class="col-md-8 px-4">
                                <h5 class="mb-2" style="color: #ffffff; font-weight: 500;">@kitap.KitapAdi</h5>
                                <p class="mb-0" style="color: var(--silver); font-size: 0.95rem;">
                                    Yazar: <span style="color: var(--star-beige);">@kitap.Yazar.AdSoyad</span>
                                </p>
                            </div>
                            <div class="col-md-2 text-end pr-3">
                                <h5 style="color: var(--star-beige); font-weight: bold;">₺@kitap.Fiyat.ToString("N2")</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card p-4 shadow-lg sticky-top" style="background-color: var(--space-blue); border: 1px solid var(--grey-accent); border-radius: 15px; top: 20px;">
                    <h4 style="color: #ffffff; border-bottom: 1px solid var(--grey-accent); padding-bottom: 10px;">Sipariş Özeti</h4>
                    
                    <div class="d-flex justify-content-between mt-3 mb-2" style="color: var(--silver); font-size: 1.1rem;">
                        <span>Ara Toplam (@Model.Count Ürün)</span>
                        <span style="color: #ffffff;">₺@toplamFiyat.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3" style="color: var(--silver); font-size: 1.1rem;">
                        <span>Kargo</span>
                        <span style="color: #4ade80; font-weight: bold;">Ücretsiz</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-3 pt-3" style="border-top: 1px dashed var(--silver);">
                        <h4 style="color: #ffffff; font-weight: bold;">Genel Toplam</h4>
                        <h4 style="color: var(--star-beige); font-weight: bold;">₺@toplamFiyat.ToString("N2")</h4>
                    </div>

                    <button class="btn btn-nova w-100 mt-4 btn-lg" style="font-weight: bold; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(245, 245, 220, 0.2);">
                        Ödeme Yap
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light w-100 mt-3" style="font-size: 1.05rem;">
                        Alışverişe Devam Et
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-12 text-center p-5 shadow-lg" style="background-color: var(--space-blue); border-radius: 15px; border: 1px dashed var(--silver);">
            <div style="font-size: 4rem; margin-bottom: 15px; text-shadow: 0 0 15px rgba(255,255,255,0.2);">🛒</div>
            <h3 style="color: #ffffff; margin-bottom: 15px;">Kapsülünüz şu an bomboş...</h3>
            <p style="color: var(--silver); font-size: 1.2rem;">Okunacak yeni evrenler keşfetmek için mağazamıza göz atın.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-nova mt-4 btn-lg px-5">Yolculuğa Başla</a>
        </div>
    }
</div>