@{
    ViewData["Title"] = "Tüm Kategoriler";
}

<div class="container mt-5 mb-5">
    <div class="d-flex align-items-center mb-4">
        <h2 style="color: var(--text-main); font-weight: bold; margin-bottom: 0;">
            <span style="color: var(--star-beige);">✦</span> Galaksimizdeki @ViewData["Title"]
        </h2>
    </div>
    
    <p style="color: var(--silver); font-size: 1.1rem; border-bottom: 1px solid var(--grey-accent); padding-bottom: 20px;">
        Aradığın her neyse, Nova Kitap evreninde onun için ayrılmış bir köşe mutlaka vardır. Keşfetmeye başla!
    </p>

    <h4 class="mt-4 mb-3" style="color: var(--header-bg); font-weight: bold;">📚 Kitap Türleri</h4>
    <div class="row mt-2">
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=1&isim=Klasik" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">📜</div>
                    <h5 class="cat-title">Klasikler</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=2&isim=Edebiyat" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">🖋️</div>
                    <h5 class="cat-title">Edebiyat</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=3&isim=Psikoloji" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">🧠</div>
                    <h5 class="cat-title">Psikoloji</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=4&isim=Tarih" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">🏛️</div>
                    <h5 class="cat-title">Tarih</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=5&isim=Felsefe" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">🤔</div>
                    <h5 class="cat-title">Felsefe</h5>
                </div>     
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=6&isim=Polisiye" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">🕵️‍♂️</div>
                    <h5 class="cat-title">Polisiye</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=7&isim=Roman" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card">
                    <div class="cat-icon">📖</div>
                    <h5 class="cat-title">Roman</h5>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=1004&isim=Dunya Klasikleri" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card" style="border-top: 2px solid var(--star-beige);">
                    <div class="cat-icon">🌍</div>
                    <h5 class="cat-title">Dünya Klasikleri</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=1005&isim=Turk Edebiyati" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card" style="border-top: 2px solid var(--star-beige);">
                    <div class="cat-icon">🇹🇷</div>
                    <h5 class="cat-title">Türk Edebiyatı</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=1006&isim=Bilim Kurgu" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card" style="border-top: 2px solid var(--star-beige);">
                    <div class="cat-icon">🚀</div>
                    <h5 class="cat-title">Bilim Kurgu</h5>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 mb-4">
            <a href="/Home/Kategori?id=1009&isim=Kisisel Gelisim" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card" style="border-top: 2px solid var(--star-beige);">
                    <div class="cat-icon">🌱</div>
                    <h5 class="cat-title">Kişisel Gelişim</h5>
                </div>
            </a>
        </div>
    </div>

    <h4 class="mt-5 mb-3" style="color: var(--header-bg); font-weight: bold;">🚀 Diğer Evrenler</h4>
    <div class="row mt-2">
        <div class="col-md-4 col-sm-6 mb-4">
            <a href="/Home/Yazarlar" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card special-card" style="border-bottom: 4px solid var(--star-beige);">
                    <div class="cat-icon">✍️</div>
                    <h4 class="cat-title">Yazarlarımız</h4>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6 mb-4">
            <a href="/Home/Kirtasiye" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card special-card" style="border-bottom: 4px solid #4A80A8;">
                    <div class="cat-icon">✒️</div>
                    <h4 class="cat-title">Kırtasiye & Ofis</h4>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6 mb-4">
            <a href="/Home/Oyuncak" class="text-decoration-none">
                <div class="card h-100 p-4 text-center shadow-sm category-card special-card" style="border-bottom: 4px solid #32CD32;">
                    <div class="cat-icon">🧸</div>
                    <h4 class="cat-title">Oyuncak Dünyası</h4>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .category-card { border-radius: 15px; transition: all 0.3s ease; border: 1px solid var(--grey-accent); background-color: var(--card-bg); }
    .cat-icon { font-size: 3.5rem; margin-bottom: 15px; transition: transform 0.3s ease; }
    .cat-title { color: var(--text-main); font-weight: 600; margin-bottom: 0; }
    .category-card:hover { transform: translateY(-8px); box-shadow: 0 12px 25px rgba(0,0,0,0.1) !important; border-color: var(--star-beige) !important; background-color: rgba(212, 175, 55, 0.03) !important; }
    .category-card:hover .cat-icon { transform: scale(1.15); }
    .category-card:hover .cat-title { color: var(--star-beige); }
    .special-card { background-color: #f8f9fa; }
</style>