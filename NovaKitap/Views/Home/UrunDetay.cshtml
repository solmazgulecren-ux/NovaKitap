                        </div>
                        <small style="color: var(--silver);">(@yorumSayisi Değerlendirme)</small>
                    </div>
                </div>

                <h2 class="mb-4" style="color: #4ade80; font-weight: 800; font-size: 2.5rem;">₺@Model.Fiyat.ToString("N2")</h2>
                
                <p style="color: var(--silver); line-height: 1.8; font-size: 1.1rem; margin-bottom: 30px;">
                    @(string.IsNullOrEmpty(Model.Aciklama) ? "Bu ürün için henüz detaylı bir açıklama girilmemiştir." : Model.Aciklama)
