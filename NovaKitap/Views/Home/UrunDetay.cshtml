@{
    ViewData["Title"] = Model.UrunAdi;
    string markaLabel = Model.UrunTipi == "Kitap" ? "Yazar / Yayınevi" : "Marka / Özellik";
    
    // Dinamik Yıldız Hesaplama
    int yorumSayisi = Model.YorumlarListesi != null ? Model.YorumlarListesi.Count : 0;
    double ortalamaPuan = yorumSayisi > 0 ? Model.YorumlarListesi.Average(y => y.Yildiz) : 0;
}

<div class="container mt-5 mb-5">
    <div class="mb-4">
