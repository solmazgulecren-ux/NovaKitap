                    @Model.UrunTipi
                </span>
                
                <h1 style="color: #ffffff; font-weight: 800; font-size: 2.2rem;" class="mb-2">@Model.UrunAdi</h1>
                
                <div class="mb-4 pb-3" style="border-bottom: 1px dashed rgba(192,192,192,0.2);">
