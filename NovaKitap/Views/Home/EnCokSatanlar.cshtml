@model IEnumerable<NovaKitap.Models.UrunViewModel>

@{
    ViewData["Title"] = "En Çok Satan Ürünler";
}

<div class="container mt-5">
    <h2 class="text-center mb-4" style="color: var(--header-bg); font-weight: bold;">
        <i class="bi bi-trophy" style="color: var(--star-beige);"></i> En Çok Satanlar
    </h2>
    <hr class="mb-5" style="width: 100px; margin: auto; border: 2px solid var(--star-beige);">

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        
        @foreach (var urun in Model)
        {
            <div class="col">
                <div class="card h-100 shadow border-0" style="background: linear-gradient(145deg, #ffffff, #f8f9fa); border-radius: 15px;">
                    <div class="text-center pt-4 position-relative">
                        <img src="@urun.KapakResimUrl" class="img-fluid rounded" alt="@urun.UrunAdi" style="height: 220px; object-fit: contain;">
                    </div>
                    <div class="card-body text-center mt-2">
                        <h6 class="fw-bold mb-1" style="color: var(--text-main);">@urun.UrunAdi</h6>
                        <div class="mb-2" style="color: var(--star-beige);">
                            ✦ ✦ ✦ ✦ ✦
                        </div>
                        <p class="h5" style="color: var(--header-bg); font-weight: bold;">@urun.Fiyat.ToString("C2")</p>
                        <span class="badge bg-light text-dark border">@urun.UrunTipi</span>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <button class="btn btn-nova w-75 rounded-pill shadow-sm">Sepete Ekle</button>
                    </div>
                </div>
            </div>
        }

    </div>
</div>