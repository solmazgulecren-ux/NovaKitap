@model List<NovaKitap.Models.UrunViewModel>

@{
    ViewData["Title"] = "Arama Sonuçları";
}
<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: var(--silver); font-weight: bold;">
            <span style="color: var(--star-beige);">✦</span> '@ViewBag.AramaKelimesi' İçin Sonuçlar
        </h2>
    </div>
    
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var urun in Model)
            {
                // DİNAMİK RENK KODLAMASI
                string etiketRengi = urun.UrunTipi == "Kitap" ? "#FFD700" : (urun.UrunTipi == "Kırtasiye" || urun.UrunTipi == "Kirtasiye" ? "#00BFFF" : "#32CD32");
                string yaziRengi = urun.UrunTipi == "Kitap" ? "#000" : "#fff";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative" style="background-color: var(--space-blue); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.3s ease;">
                        
                        <img src="@(string.IsNullOrEmpty(urun.KapakResimUrl) ? "https://via.placeholder.com/220x300/1B2A4A/C0C0C0?text=Gorsel+Yok" : urun.KapakResimUrl)"
                             class="card-img-top" alt="@urun.UrunAdi" style="height: 240px; object-fit: cover;">
                        
                        <span class="badge position-absolute top-0 start-0 m-2" style="background-color: @etiketRengi; color: @yaziRengi; font-weight: bold; z-index: 5;">
                            @urun.UrunTipi
                        </span>

                        <div class="card-body d-flex flex-column text-center p-3">
                            <h6 class="card-title text-light fw-bold mb-2" style="font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@urun.UrunAdi">
                                @urun.UrunAdi
                            </h6>
                            <h5 class="mt-auto mb-3" style="color: var(--star-beige); font-weight: bold;">
                                ₺@urun.Fiyat.ToString("N2")
                            </h5>
                            
                            <div class="d-flex gap-2">
                                <a asp-controller="Home" asp-action="Detay" asp-route-id="@urun.Id" asp-route-tip="@urun.UrunTipi"
                                   class="btn btn-sm btn-outline-light flex-fill py-2" style="border-radius: 8px;">İncele</a>
                                
                                <a asp-controller="Home" asp-action="SepeteEkle" asp-route-id="@urun.Id" asp-route-tip="@urun.UrunTipi"
                                   class="btn btn-sm btn-nova flex-fill py-2" style="border-radius: 8px;">Ekle 🛒</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h4 style="color: var(--silver);">Maalesef aradığınız kriterlere uygun ürün bulamadık.</h4>
                <p class="text-muted fs-5 mt-2">Lütfen farklı bir kelime, yazar veya marka adı ile tekrar deneyin.</p>
                <a href="/Home/Index" class="btn btn-outline-light mt-3">Ana Sayfaya Dön</a>
            </div>
        }
    </div>
</div>