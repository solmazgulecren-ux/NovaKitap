@{
    ViewData["Title"] = "Oyuncaklar ve Hobiler";
}
<div class="container mt-4">
    <h2 style="color: var(--silver);">
        <span style="color: var(--star-beige);">🧸</span> @ViewData["Title"]
    </h2>
    <hr style="border-color: var(--grey-accent);" />
    <div class="p-5 text-center shadow-lg" style="background-color: var(--space-blue); border-radius: 15px; border: 1px dashed var(--star-beige);">
        <div style="font-size: 4rem; margin-bottom: 20px;">🧩🎲</div>
        <h3 style="color: #ffffff;">Eğlence Dolu Oyuncaklar Yolda!</h3>
        <p class="text-light fs-5 mt-3">Kutu oyunları, figürler ve çok daha fazlası çok yakında Nova dünyasında...</p>
    </div>
</div>